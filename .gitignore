# Project runtime data.
# Importante: `storage/` SÍ va anchorado al root porque existe
# packages/storage/ como código. Los demás se mantienen loose
# (runtime data se crea bajo services/*/data o similares).
data/
/storage/
tmp/
*.sqlite
*.sqlite-journal
*.db

# Docker volumes
.docker-data/

# Native local orchestration (start-local.ps1 / stop-local.ps1)
.local-pids/
.local-logs/

# Test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/

# Generated outputs (conversion results during dev)
output/
fixtures-out/

# Source archives (e.g. `git archive` output used to deploy to the Pi)
*.tar.gz
*.tgz

# Local-only docs / planning / Claude config (no se publican al repo)
docs/
Plan y mockup/
.claude/
CLAUDE.md
