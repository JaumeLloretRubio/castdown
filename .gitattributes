# Forzar LF en archivos que se ejecutan en Linux/Pi/contenedores.
# Sin esto, Git Windows convierte a CRLF y bash explota con
# "bad interpreter: /bin/bash^M".

* text=auto eol=lf

# Scripts shell — críticos
*.sh           text eol=lf
*.bash         text eol=lf

# Python — ejecutado en markitdown-svc
*.py           text eol=lf

# Docker — interpretado por linux daemon
Dockerfile     text eol=lf
*.dockerfile   text eol=lf
.dockerignore  text eol=lf

# YAML — compose + CI + workflows
*.yml          text eol=lf
*.yaml         text eol=lf

# Config — JSON, TOML, env
*.json         text eol=lf
*.toml         text eol=lf
*.env          text eol=lf
*.env.example  text eol=lf
.env.local.example text eol=lf

# TypeScript / JavaScript / TSX / JSX
*.ts           text eol=lf
*.tsx          text eol=lf
*.js           text eol=lf
*.jsx          text eol=lf
*.mjs          text eol=lf
*.cjs          text eol=lf

# Markdown
*.md           text eol=lf

# CSS / HTML — templates
*.css          text eol=lf
*.html         text eol=lf

# Caddyfile — sin extensión, interpretado por caddy
Caddyfile      text eol=lf

# Windows-only (si alguna vez los hubiera)
*.ps1          text eol=crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Binarios
*.png          binary
*.jpg          binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.zip          binary
*.tar          binary
*.tgz          binary
