{
  "name": "castdown-mcp",
  "version": "0.1.0",
  "description": "MCP server for castdown — cast files/URLs to Markdown from any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "castdown-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "markdown", "converter", "claude", "agents", "self-host"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaumeLloretRubio/castdown"
  }
}
