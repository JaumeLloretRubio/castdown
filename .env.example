# ──────────────────────────────────────────────────────────────
# castdown — environment variables
# Copy to .env and adjust.
# ──────────────────────────────────────────────────────────────

# ── Runtime ────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── API gateway ────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3001

# Auth — comma-separated list of valid API keys for dev.
# In prod, use database-backed keys (apps/api/src/auth).
API_KEYS=cd_dev_changeme

# Key que usa el web container (perfil cloud) para hablar con la api. Tiene que
# coincidir con uno de los valores de API_KEYS. install-pi.sh las mantiene sincronizadas.
WEB_API_KEY=cd_dev_changeme

# Rate limiting (per API key, per minute)
RATE_LIMIT_PER_MINUTE=60

# CORS allowlist (comma-separated). Añadir el dominio Vercel cuando se conozca.
# Ej: WEB_ORIGIN=http://localhost:3000,https://castdown-web.vercel.app
WEB_ORIGIN=http://localhost:3000

# ── Microservices (internal docker network) ────────────────────
MARKITDOWN_URL=http://markitdown-svc:8001
PANDOC_URL=http://pandoc-svc:8002
CRAWLER_URL=http://crawler-svc:8003

# ── Storage ────────────────────────────────────────────────────
STORAGE_PATH=/data
MAX_FILE_SIZE_MB=50
RESULT_TTL_HOURS=24

# ── Redis (job queue + rate limit) ─────────────────────────────
REDIS_URL=redis://redis:6379

# ── Database ───────────────────────────────────────────────────
# SQLite for dev. Postgres for prod-scale.
DATABASE_URL=file:/data/castdown.db

# ── Crawler ────────────────────────────────────────────────────
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_DEFAULT_DEPTH=2
CRAWLER_MAX_PAGES=500

# ── Web frontend (cuando se levanta con `docker compose --profile cloud up`) ──
WEB_PORT=3000

# ──────────────────────────────────────────────────────────────
# Vars para Vercel (NO se usan en Pi, se ponen en el panel de Vercel)
# ──────────────────────────────────────────────────────────────
# CASTDOWN_API_URL=https://<pi-machine>.<tailnet>.ts.net
# CASTDOWN_API_KEY=cd_xxx_long_random
