# ──────────────────────────────────────────────────────────────
# castdown — LOCAL-dev environment (no Docker)
# Copy to .env.local and source it before starting services.
#
# Differences vs .env.example (docker-compose):
#   - Service URLs use localhost, not docker DNS (markitdown-svc, etc.)
#   - Storage / DB paths are relative (Windows-friendly)
#   - Redis URL points at a likely-unreachable local instance — gateway
#     fails open if you don't have Memurai / WSL Redis / Redis on PATH.
# ──────────────────────────────────────────────────────────────

# ── Runtime ────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Suppress node:sqlite experimental warning on every prepared statement load
NODE_NO_WARNINGS=1

# ── API gateway ────────────────────────────────────────────────
API_PORT=3001
API_HOST=127.0.0.1
API_PUBLIC_URL=http://localhost:3001

API_KEYS=cd_dev_changeme
RATE_LIMIT_PER_MINUTE=60

# ── Microservices (localhost) ──────────────────────────────────
MARKITDOWN_URL=http://localhost:8001
PANDOC_URL=http://localhost:8002
CRAWLER_URL=http://localhost:8003

# ── Storage (relative paths) ───────────────────────────────────
STORAGE_PATH=./data
MAX_FILE_SIZE_MB=50
RESULT_TTL_HOURS=24

# ── Redis (optional, fails open) ───────────────────────────────
# Comment out if you have no Redis — the gateway already logs one warning
# and switches to fail-open. Leaving the URL in keeps the option for when
# you start Memurai / WSL redis-server.
REDIS_URL=redis://localhost:6379

# ── Database (relative SQLite file via node:sqlite) ────────────
DATABASE_URL=file:./data/castdown.db

# ── Crawler ────────────────────────────────────────────────────
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_DEFAULT_DEPTH=2
CRAWLER_MAX_PAGES=500

# ── Web frontend ───────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
