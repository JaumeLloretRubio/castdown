{
  "name": "@castdown/cli",
  "version": "0.1.0-alpha",
  "description": "castdown CLI — talk to a local or remote castdown API",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "castdown": "src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
